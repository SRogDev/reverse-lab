# .env.example — placeholder keys for Reverse Lab (Phase 1+)
#
# Copy to `.env` and fill in real values locally. NEVER commit real values:
# `.env` is gitignored; this file ships placeholders only.
#
# Phase 1 needs NONE of these — FileStore + LocalExecutor + REA CLI work
# with zero keys. Each key unlocks a later phase (noted below).

# Phase 3 — investigation engine (Vercel AI SDK via AI Gateway)
AI_GATEWAY_API_KEY=

# Phase 2 — Supabase persistence (schema in supabase/migrations/)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Phase 4 — isolated execution (Vercel Sandbox)
VERCEL_TOKEN=

# Optional — skip npx startup (~70s) by pointing at a pre-installed rea binary
# REA_BIN=/path/to/rea-agents/scripts/rea.mjs
